# Comma-separated, archive-capable JSON-RPC endpoints. Do not commit real values.
RPC_URLS=https://rpc-1.example.invalid,https://rpc-2.example.invalid
# One group per RPC_URLS entry. Independent groups are required for legacy verification.
RPC_PROVIDER_GROUPS=provider_a,provider_b

# gnosis or ethereum. Both write the same database (rows key on chain_id); run one
# writer per chain, so a mainnet deployment sets CHAIN=ethereum with mainnet RPC_URLS.
CHAIN=gnosis
CONFIG_ROOT=config
# Discovered treasury targets whose last N census attempts all failed are excluded from
# new batches (recorded, never zeroed).
DISCOVERED_QUARANTINE_THRESHOLD=3
ABI_ROOT=abis
MIGRATIONS_DIR=migrations

CLICKHOUSE_HOST=clickhouse.example.invalid
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=replace-me
CLICKHOUSE_DATABASE=rpc_indexer
CLICKHOUSE_SECURE=true
CLICKHOUSE_VERIFY=true

RPC_CONCURRENCY=8
RPC_REQUESTS_PER_SECOND=30
MULTICALL_BATCH_SIZE=250
LEGACY_RPC_BATCH_SIZE=100
MAX_RETRIES=5
WRITER_STALE_SECONDS=120
METRICS_PORT=9090
DAEMON_POLL_SECONDS=300
# Comma-separated job names the daemon runs each cycle; empty = every daily job.
# Scope a single daemon away from the full multi-thousand-target catalog, e.g.
# DAEMON_JOBS=daily_pool_reserves,daily_cl_liquidity
DAEMON_JOBS=
# Concentrated-liquidity pools below this active liquidity() are ingested state-only
# (no per-tick sweep). 0 = always sweep ticks.
CL_MIN_ACTIVE_LIQUIDITY=0
LOG_LEVEL=INFO
